# 1. Copie para .env: cp .env.example .env
# 2. Crie uma chave real: openssl rand -hex 32
# SQLite local (padrão):
DATABASE_URL=sqlite:///./taskflow.db
# PostgreSQL com Docker (descomente e defina POSTGRES_PASSWORD também):
# DATABASE_URL=postgresql+psycopg2://taskflow:senha-aqui@127.0.0.1:5432/taskflow
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Apenas para docker compose: use a MESMA senha na DATABASE_URL acima.
POSTGRES_PASSWORD=
