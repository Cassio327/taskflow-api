# Copie para .env: cp .env.example .env
# Gere SECRET_KEY com: openssl rand -hex 32
# Gere POSTGRES_PASSWORD (na primeira inicializacao) com: openssl rand -hex 16

# Para executar Python fora do Docker (SQLite por padrao):
DATABASE_URL=sqlite:///./taskflow.db
# Para executar Python fora do Docker usando Postgres local:
# DATABASE_URL=postgresql+psycopg2://taskflow:SENHA@127.0.0.1:5432/taskflow

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Docker Compose usa estas variaveis; a URL do container e montada com host db.
POSTGRES_PASSWORD=
